        "meta.class.python entity.name.type.class.python",
        "entity.name.type.class.python"
      ],
      "settings": {
        "foreground": "#F4F2EC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
